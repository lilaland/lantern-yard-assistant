# Copy to .env (gitignored). The assistant reads these at startup.
ANTHROPIC_API_KEY=
MARBLE_API_BASE=http://127.0.0.1:8765
MARBLE_AGENT_TOKEN=demo-agent-site-01
# claude-opus-5-5 by default; claude-sonnet-5-5 is the cheaper option.
MARBLE_MODEL=claude-sonnet-5-5
MARBLE_EFFORT=medium
# Local assistant state (ledger, usage log). Never the simulator's .state/.
MARBLE_STATE_DIR=.marble
